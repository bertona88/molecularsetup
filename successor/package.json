{
  "name": "molecularsetup-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bash scripts/build-verified.sh",
    "engine:build": "bash scripts/build-engine.sh",
    "engine:verify": "bash scripts/verify-engine.sh",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/engine-abi.test.mjs tests/source-architecture.test.mjs",
    "test:engine": "npm run engine:verify && node --test tests/engine-abi.test.mjs",
    "test:engine:native": "cargo test --manifest-path engine/Cargo.toml --locked --offline",
    "test:browser": "playwright test",
    "benchmark:engine": "node scripts/benchmark-engine.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "globals": "17.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.0.13"
  },
  "type": "module",
  "displayName": "MolecularSetup Lab"
}
