{
  "name": "molecularsetup",
  "version": "0.0.0",
  "private": true,
  "description": "Preliminary Setup Universe wrapper for MolecularSetup.",
  "homepage": "https://molecularsetup.com/",
  "scripts": {
    "successor:install": "npm --prefix successor run restore:lock && npm --prefix successor install",
    "successor:dev": "npm --prefix successor run dev",
    "successor:build": "npm --prefix successor run build",
    "successor:test": "npm --prefix successor test",
    "successor:lint": "npm --prefix successor run lint",
    "prototype:test": "npm --prefix prototype test",
    "prototype:check": "npm --prefix prototype run check",
    "prototype:serve": "npm --prefix prototype run serve"
  }
}
